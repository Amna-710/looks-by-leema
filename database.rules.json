{
  "rules": {
    "site": {
      "settings": {
        ".read": true,
        ".write": true
      },
      "testimonials": {
        ".read": true,
        ".write": true
      }
    },
    "bookings": {
      ".read": true,
      "$bookingId": {
        ".write": true,
        ".validate": "newData.hasChildren(['fullName', 'email', 'phone', 'service', 'date', 'time', 'status'])"
      }
    }
  }
}
