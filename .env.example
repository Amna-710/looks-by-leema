# Firebase configuration — copy to .env
# Get these from Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=looksbyleema-52909.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=looksbyleema-52909
VITE_FIREBASE_STORAGE_BUCKET=looksbyleema-52909.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=74052703446
VITE_FIREBASE_APP_ID=1:74052703446:web:YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_DATABASE_URL=https://looksbyleema-52909-default-rtdb.firebaseio.com

# Comma-separated admin emails allowed to sign in (default: looksbyleema@gmail.com)
VITE_ADMIN_EMAILS=looksbyleema@gmail.com

