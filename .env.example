# Firebase configuration — copy to .env
# Get these from Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Comma-separated admin emails allowed to sign in (default: looksbyleema@gmail.com)
VITE_ADMIN_EMAILS=looksbyleema@gmail.com

# ---------------------------------------------------------------------------
# Booking email (server-side only — Vercel env vars / functions/.env)
# NEVER prefix SMTP secrets with VITE_
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
SMTP_USER=looksbyleema@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=Looks By Leema <looksbyleema@gmail.com>
